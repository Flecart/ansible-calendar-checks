# Gmail credentials — same format as skills/send-note/.env
GMAIL_USER=REPLACE_ME@gmail.com
GMAIL_APP_PASSWORD=REPLACE_ME

# Display name used in the From field of outgoing emails
SENDER_NAME=Jinesis Bot

# How many days ahead to scan for events with pending RSVPs
LOOKAHEAD_DAYS=7

# Path to your OAuth client credentials (downloaded from Google Cloud Console)
GOOGLE_CREDENTIALS_PATH=credentials.json

# Where to persist the OAuth token after the first browser login
GOOGLE_TOKEN_PATH=token.json

# Set to true to also remind attendees who replied "Maybe"
INCLUDE_TENTATIVE=false
